# --- Servicio ---
PORT=3000
# URL pública (HTTPS) con la que Redsys y los usuarios llegan a este servicio
PUBLIC_URL=https://recargas.ejemplo.com
DATABASE_URL=postgres://pasarela:cambiar@localhost:5432/pasarela
# Token para el listado de pedidos de soporte (/admin/pedidos)
ADMIN_TOKEN=cambiar-por-un-valor-largo-y-aleatorio
# Opcional: URL que recibe un POST JSON por cada alerta (Teams, Slack, etc.)
ALERT_WEBHOOK_URL=

# --- Límites de recarga (en céntimos) ---
IMPORTE_MIN_CENTIMOS=100
IMPORTE_MAX_CENTIMOS=10000

# --- Redsys ---
# Pruebas: https://sis-t.redsys.es:25443/sis/realizarPago
# Real:    https://sis.redsys.es/sis/realizarPago
REDSYS_URL=https://sis-t.redsys.es:25443/sis/realizarPago
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
# Clave de firma SHA-256 del comercio (en base64, tal como la da el banco)
REDSYS_KEY=
REDSYS_MERCHANT_NAME=Recarga de impresión
# Firma de las peticiones: HMAC_SHA512_V2 (actual) o HMAC_SHA256_V1 (anterior)
REDSYS_SIGNATURE_VERSION=HMAC_SHA512_V2

# --- MyQ X ---
# Base de la API REST, incluyendo /api (p. ej. https://myq.ejemplo.local:8090/api)
MYQ_API_URL=
MYQ_API_VERSION=v3
MYQ_CLIENT_ID=
MYQ_CLIENT_SECRET=
MYQ_SCOPE=credit users
MYQ_PROVIDER=external
